# Copy this file to `.env` and edit. `.env` is gitignored — never commit it.

# Secret used to sign the session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000

# Set to "production" when deploying behind HTTPS. This flips the session
# cookie to Secure, so it will stop working over plain http:// — keep it
# unset (or "development") when running locally.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Agent (admin) account
# ---------------------------------------------------------------------------
# On EVERY boot the server makes this account match these values exactly —
# creating it if missing, and otherwise forcing its role to admin and its
# password to ADMIN_PASSWORD. That's deliberate: it's what stops a player
# from ever owning the agent seat just by registering the same username
# first, and it's what makes rotating this password here actually take
# effect on restart. Leave both blank to run with no agent (players can
# still play, but nothing gets reviewed or rewarded).
ADMIN_USERNAME=agent
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Proof judging
# ---------------------------------------------------------------------------
# Questism verifies penalty proof with deterministic, machine-checkable rules
# (word counts, source counts, duplicate-file detection, real-image checks).
# This works with NO API key and is the default — the demo never depends on
# a network call.
#
# Optionally, an AI judge can be layered ON TOP as a second opinion. It can
# only ever REJECT a submission the deterministic rules passed; it can never
# approve one they failed. Leave blank to run keyless.
ANTHROPIC_API_KEY=
